# uv project: sync (fast when up to date; again whenever uv.lock or
# pyproject.toml change) and activate .venv, for the shell and nvim alike.
layout uv

# ninja, which tests/test_approx.py needs to build its C++ extension. From nix
# where there is one; otherwise it has to be on PATH already.
if has nix; then
  PATH_add "$(nix build --no-link --print-out-paths nixpkgs#ninja)/bin"
fi
